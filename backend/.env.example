NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000
DATABASE_URL=postgresql://postgres:replace-with-strong-password@localhost:5432/distribuidora_erp?schema=public
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5
PRISMA_CONNECT_ON_START=true

# O docker compose exige POSTGRES_PASSWORD; use o mesmo valor na DATABASE_URL
POSTGRES_PASSWORD=replace-with-strong-password
# PIX direto para a conta vinculada à chave; confirmação manual
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=
# Bootstrap: definir temporariamente para npm run admin:create
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Demonstração é opcional e proibida em produção
ALLOW_DEMO_SEED=false
SEED_ADMIN_PASSWORD=

# Mercado Pago Point: deixar vazio mantém o modo manual disponível.
# Chave AES de 32 bytes em Base64. Gerar uma chave exclusiva por instância e guardar em secret store.
CARD_CREDENTIALS_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://erp.exemplo.com/v1/card-payments/mercado-pago/callback
MP_RETURN_URL=https://erp.exemplo.com/maquininhas
MP_WEBHOOK_SECRET=
# true é o padrão seguro. Mudar para false somente após validar a integração no aparelho.
MP_TEST_MODE=true
