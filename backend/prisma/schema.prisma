generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  vendedor
  entregador
  caixa
  financeiro
  estoquista
  fiscal
  compras
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_ROUTE
  DELIVERED
  FAILED
}

enum FinancialType {
  RECEIVABLE
  PAYABLE
}

enum FinancialStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  RENEGOTIATED
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
}

enum RegistryType {
  ESTABLISHMENT
  OPERATION_NATURE
  TAX_CATEGORY
  TAX_RULE
  SUPPLIER
  SELLER
  PAYMENT_METHOD
  CITY
  ACTIVITY_PROFILE
  BRAND
  UNIT
  SECTION
  PRODUCT_GROUP
  PRODUCT_SUBGROUP
  ICMS_ISS_CALC_FUNCTION
  COMPLEMENT_SUBSTANCE
  PROJECT
  PLATFORM
  NCM_CODE
  CFOP_CODE
  FREIGHT_TABLE
  CARRIER
  VEHICLE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum InventoryCountStatus {
  DRAFT
  COUNTING
  CLOSED
  CANCELLED
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  CANCELLED
}

enum CashMovementType {
  SALE
  RECEIPT
  PAYMENT
  WITHDRAWAL
  SUPPLY
  TRANSFER
  ADJUSTMENT
}

enum BankTransactionType {
  CREDIT
  DEBIT
}

enum BankTransactionStatus {
  PENDING
  RECONCILED
  IGNORED
}

model User {
  id                   String                 @id @default(cuid())
  name                 String
  email                String                 @unique
  passwordHash         String
  role                 Role
  isActive             Boolean                @default(true)
  failedLoginAttempts  Int                    @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  clients              Client[]
  orders               Order[]
  deliveries           Delivery[]             @relation("DeliveryPerson")
  inventoryMovements   InventoryMovement[]
  financialEntries     FinancialTransaction[]
  issuedInvoices       Invoice[]
  openedCashSessions   CashSession[]          @relation("OpenedCashSessions")
  closedCashSessions   CashSession[]          @relation("ClosedCashSessions")
  cashMovements        CashMovement[]
  purchaseOrders       PurchaseOrder[]
  payments             Payment[]
  financialSettlements FinancialSettlement[]
  commissions          Commission[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]

  @@index([role, isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Client {
  id                    String                 @id @default(cuid())
  tradeName             String
  legalName             String
  document              String                 @unique
  email                 String?
  phone                 String?
  address               String
  cityId                String?
  activityProfileId     String?
  creditLimit           Decimal                @default(0) @db.Decimal(12, 2)
  status                String                 @default("ACTIVE")
  notes                 String?
  createdById           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdBy             User                   @relation(fields: [createdById], references: [id])
  orders                Order[]
  financialTransactions FinancialTransaction[]

  @@index([createdById])
  @@index([tradeName])
}

model Product {
  id                 String                 @id @default(cuid())
  sku                String                 @unique
  barcode            String?
  name               String
  description        String?
  groupId            String?
  subgroupId         String?
  brandId            String?
  unitId             String?
  sectionId          String?
  ncmId              String?
  cfopId             String?
  taxCategoryId      String?
  price              Decimal                @db.Decimal(12, 2)
  cost               Decimal                @db.Decimal(12, 2)
  minStock           Int
  maxStock           Int?
  trackBatch         Boolean                @default(false)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseOrderItem[]
  prices             ProductPrice[]
  barcodes           ProductBarcode[]
  countItems         InventoryCountItem[]
  reservations       InventoryReservation[]

  @@index([name])
  @@index([groupId, subgroupId])
  @@index([brandId, unitId])
  @@index([ncmId, cfopId])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  productId String
  code      String   @unique
  type      String   @default("EAN")
  source    String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([code])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  productId   String
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(12, 3)
  unitCost    Decimal?              @db.Decimal(12, 2)
  batchNumber String?
  expiresAt   DateTime?
  reason      String?
  createdById String
  createdAt   DateTime              @default(now())
  product     Product               @relation(fields: [productId], references: [id])
  createdBy   User                  @relation(fields: [createdById], references: [id])

  @@index([productId, type])
  @@index([batchNumber, expiresAt])
}

model InventoryReservation {
  id          String                     @id @default(cuid())
  productId   String
  orderId     String?
  quantity    Decimal                    @db.Decimal(12, 3)
  status      InventoryReservationStatus @default(ACTIVE)
  reason      String?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  product     Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([orderId])
}

model InventoryCountSession {
  id          String               @id @default(cuid())
  code        String?              @unique
  status      InventoryCountStatus @default(DRAFT)
  description String?
  startedAt   DateTime?
  closedAt    DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       InventoryCountItem[]

  @@index([status, createdAt])
}

model InventoryCountItem {
  id            String                @id @default(cuid())
  sessionId     String
  productId     String
  barcode       String?
  expectedQty   Decimal               @default(0) @db.Decimal(12, 3)
  countedQty    Decimal               @default(0) @db.Decimal(12, 3)
  differenceQty Decimal               @default(0) @db.Decimal(12, 3)
  unitCost      Decimal?              @db.Decimal(12, 2)
  countedAt     DateTime              @default(now())
  session       InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id])

  @@unique([sessionId, productId])
  @@index([productId])
}

model Order {
  id                    String                 @id @default(cuid())
  clientId              String
  sellerId              String
  status                OrderStatus            @default(DRAFT)
  totalAmount           Decimal                @db.Decimal(12, 2)
  discountAmount        Decimal                @default(0) @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  client                Client                 @relation(fields: [clientId], references: [id])
  seller                User                   @relation(fields: [sellerId], references: [id])
  items                 OrderItem[]
  delivery              Delivery?
  invoice               Invoice?
  financialTransactions FinancialTransaction[]
  payments              Payment[]
  commissions           Commission[]

  @@index([clientId, createdAt])
  @@index([sellerId, status])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  quantity   Decimal  @db.Decimal(12, 3)
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Delivery {
  id               String         @id @default(cuid())
  orderId          String         @unique
  deliveryPersonId String
  status           DeliveryStatus @default(PENDING)
  notes            String?
  proofUrl         String?
  assignedAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson   User           @relation("DeliveryPerson", fields: [deliveryPersonId], references: [id])

  @@index([deliveryPersonId, status])
}

model FinancialTransaction {
  id                String                 @id @default(cuid())
  orderId           String?
  clientId          String?
  createdById       String
  type              FinancialType
  status            FinancialStatus        @default(PENDING)
  amount            Decimal                @db.Decimal(12, 2)
  originalAmount    Decimal                @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal                @default(0) @db.Decimal(12, 2)
  interestAmount    Decimal                @default(0) @db.Decimal(12, 2)
  penaltyAmount     Decimal                @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal                @default(0) @db.Decimal(12, 2)
  description       String
  documentNumber    String?
  dueDate           DateTime
  paidAt            DateTime?
  supplierId        String?
  supplierName      String?
  categoryId        String?
  costCenterId      String?
  paymentMethodId   String?
  paymentMethodName String?
  installmentNumber Int                    @default(1)
  totalInstallments Int                    @default(1)
  parentId          String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  order             Order?                 @relation(fields: [orderId], references: [id])
  client            Client?                @relation(fields: [clientId], references: [id])
  createdBy         User                   @relation(fields: [createdById], references: [id])
  payments          Payment[]
  settlements       FinancialSettlement[]
  parent            FinancialTransaction?  @relation("FinancialInstallments", fields: [parentId], references: [id])
  children          FinancialTransaction[] @relation("FinancialInstallments")

  @@index([type, status, dueDate])
  @@index([orderId])
  @@index([clientId])
  @@index([supplierId])
  @@index([categoryId])
  @@index([costCenterId])
}

model FinancialSettlement {
  id                     String               @id @default(cuid())
  financialTransactionId String
  amount                 Decimal              @db.Decimal(12, 2)
  interestAmount         Decimal              @default(0) @db.Decimal(12, 2)
  penaltyAmount          Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount         Decimal              @default(0) @db.Decimal(12, 2)
  methodId               String?
  methodName             String
  receiptNumber          String?
  notes                  String?
  settledAt              DateTime             @default(now())
  createdById            String
  financialTransaction   FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Cascade)
  createdBy              User                 @relation(fields: [createdById], references: [id])

  @@index([financialTransactionId])
  @@index([settledAt])
}

model Invoice {
  id                String        @id @default(cuid())
  orderId           String        @unique
  issuedById        String
  status            InvoiceStatus @default(PENDING)
  number            String?       @unique
  accessKey         String?       @unique
  externalReference String?
  xmlContent        String?
  rejectionReason   String?
  issuedAt          DateTime      @default(now())
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issuedBy          User          @relation(fields: [issuedById], references: [id])

  @@index([status, issuedAt])
}

model RegistryEntry {
  id          String       @id @default(cuid())
  type        RegistryType
  code        String?
  name        String
  description String?
  isActive    Boolean      @default(true)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([type, code])
  @@index([type, isActive])
  @@index([name])
}

model Company {
  id                    String   @id @default(cuid())
  legalName             String
  tradeName             String
  document              String   @unique
  stateRegistration     String?
  municipalRegistration String?
  taxRegime             String?
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  settings              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  branches              Branch[]
}

model Branch {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  address      String?
  city         String?
  state        String?
  fiscalSeries Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([isActive])
}

model PriceTable {
  id            String         @id @default(cuid())
  code          String?        @unique
  name          String
  marginPercent Decimal        @default(0) @db.Decimal(7, 3)
  isDefault     Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         ProductPrice[]
}

model ProductPrice {
  id           String     @id @default(cuid())
  productId    String
  priceTableId String
  price        Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id], onDelete: Cascade)

  @@unique([productId, priceTableId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  supplierId     String?
  supplierName   String
  status         PurchaseStatus      @default(DRAFT)
  invoiceNumber  String?
  accessKey      String?
  subtotal       Decimal             @default(0) @db.Decimal(12, 2)
  freightAmount  Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal             @default(0) @db.Decimal(12, 2)
  receivedAt     DateTime?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      User                @relation(fields: [createdById], references: [id])
  items          PurchaseOrderItem[]

  @@index([supplierId, status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(12, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(12, 2)
  batchNumber     String?
  expiresAt       DateTime?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model CashSession {
  id             String            @id @default(cuid())
  openedById     String
  closedById     String?
  status         CashSessionStatus @default(OPEN)
  openingBalance Decimal           @default(0) @db.Decimal(12, 2)
  closingBalance Decimal?          @db.Decimal(12, 2)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  notes          String?
  openedBy       User              @relation("OpenedCashSessions", fields: [openedById], references: [id])
  closedBy       User?             @relation("ClosedCashSessions", fields: [closedById], references: [id])
  movements      CashMovement[]

  @@index([status, openedAt])
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  methodName    String?
  description   String
  reference     String?
  createdById   String
  createdAt     DateTime         @default(now())
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  createdBy     User             @relation(fields: [createdById], references: [id])

  @@index([cashSessionId, createdAt])
  @@index([type])
}

model Payment {
  id                     String                @id @default(cuid())
  orderId                String?
  financialTransactionId String?
  methodId               String?
  methodName             String
  amount                 Decimal               @db.Decimal(12, 2)
  paidAt                 DateTime              @default(now())
  externalReference      String?
  nsu                    String?
  createdById            String
  order                  Order?                @relation(fields: [orderId], references: [id])
  financialTransaction   FinancialTransaction? @relation(fields: [financialTransactionId], references: [id])
  createdBy              User                  @relation(fields: [createdById], references: [id])

  @@index([orderId])
  @@index([financialTransactionId])
  @@index([paidAt])
}

model BankAccount {
  id              String               @id @default(cuid())
  name            String
  bankName        String
  agency          String?
  accountNumber   String?
  balance         Decimal              @default(0) @db.Decimal(12, 2)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  reconciliations BankReconciliation[]
  transactions    BankTransaction[]
}

model BankTransaction {
  id            String                @id @default(cuid())
  bankAccountId String
  type          BankTransactionType
  status        BankTransactionStatus @default(PENDING)
  amount        Decimal               @db.Decimal(12, 2)
  description   String
  reference     String?
  occurredAt    DateTime              @default(now())
  bankAccount   BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, occurredAt])
  @@index([status])
}

model BankReconciliation {
  id                String      @id @default(cuid())
  bankAccountId     String
  amount            Decimal     @db.Decimal(12, 2)
  description       String
  externalReference String?
  reconciledAt      DateTime    @default(now())
  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, reconciledAt])
}

model ChartAccount {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      FinancialType
  parentId  String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type, isActive])
}

model CostCenter {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Commission {
  id         String           @id @default(cuid())
  orderId    String
  sellerId   String
  baseAmount Decimal          @db.Decimal(12, 2)
  percentage Decimal          @db.Decimal(7, 3)
  amount     Decimal          @db.Decimal(12, 2)
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller     User             @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
